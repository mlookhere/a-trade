{
  "version": 2,
  "branches": {"integration": "dev", "production": "main"},
  "worktrees": {"branch_prefix": "work"},
  "github": {
    "expected_owner": "mlookhere",
    "expected_repository": "a-trade",
    "control_issue_title": "[CONTROL] Current repository state",
    "release_title_prefix": "[RELEASE]",
    "branch_protection": {
      "integration": {
        "required_checks": [
          "PR metadata",
          "Fast deterministic gates",
          "PR test/build gates",
          "Dependency audit",
          "Workflow policy"
        ]
      },
      "production": {
        "required_checks": [
          "Release metadata",
          "Full regression and production build",
          "Workflow policy"
        ]
      }
    }
  },
  "commands": {
    "workflow_self_test": ["python3 workflow/self_test.py --ci"],
    "quality": ["python3 ci/quality.py"],
    "rust_format": ["cargo fmt --all -- --check"],
    "rust_lint": ["cargo clippy --workspace --all-targets --all-features -- -D warnings"],
    "rust_test": ["cargo test --workspace --all-targets --locked"],
    "rust_release_build": ["cargo build --workspace --release --locked"],
    "dependency_audit_tests": ["python3 ci/tests/dependency_audit_test.py"],
    "dependency_audit": ["python3 ci/dependency_audit.py"]
  },
  "stages": {
    "fast": ["workflow_self_test", "quality", "rust_format", "rust_lint"],
    "pr": ["rust_test", "rust_release_build"],
    "audit": ["dependency_audit_tests", "dependency_audit"],
    "release": ["workflow_self_test", "quality", "rust_format", "rust_lint", "rust_test", "rust_release_build", "dependency_audit_tests", "dependency_audit"],
    "nightly": ["workflow_self_test", "quality", "rust_format", "rust_lint", "rust_test", "rust_release_build", "dependency_audit_tests", "dependency_audit"]
  },
  "quality": {
    "base_ref": "origin/dev",
    "max_changed_files": 80,
    "max_changed_lines": 4000,
    "max_file_lines": 1200,
    "tracked_extensions": [".rs", ".py", ".md", ".json", ".toml", ".yml", ".yaml", ".sh"],
    "exclude_globs": ["target/**", "artifacts/**"]
  }
}
